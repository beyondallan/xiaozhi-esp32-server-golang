# 构建阶段（使用 Ubuntu 22.04 + Go 1.24 基础镜像）
# syntax=docker/dockerfile:1
FROM --platform=linux/amd64 ubuntu:22.04 AS builder

# 安装 Go 1.24
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    wget \
    build-essential \
    libopus-dev \
    libopusfile-dev \
    libc++-dev \
    libc++abi-dev \
    pkg-config \
    && wget -q https://go.dev/dl/go1.24.4.linux-amd64.tar.gz \
    && tar -C /usr/local -xzf go1.24.4.linux-amd64.tar.gz \
    && rm go1.24.4.linux-amd64.tar.gz \
    && rm -rf /var/lib/apt/lists/*

ENV PATH=$PATH:/usr/local/go/bin
ENV GOPROXY=https://goproxy.cn,direct
ENV GOSUMDB=sum.golang.google.cn

# 复制 onnxruntime 库文件（仅 x64）
COPY docker/lib/onnxruntime-linux-x64-1.21.0.tgz /tmp/

# 安装ONNX Runtime（x64架构）
RUN echo "Installing ONNX Runtime for x64 architecture" && \
    cd /tmp && \
    if [ ! -f "onnxruntime-linux-x64-1.21.0.tgz" ]; then \
        echo "Error: ONNX Runtime file not found!" && \
        ls -la /tmp/*.tgz 2>/dev/null || echo "No .tgz files found" && \
        exit 1; \
    fi && \
    tar -xzf onnxruntime-linux-x64-1.21.0.tgz || (echo "Failed to extract ONNX Runtime" && exit 1) && \
    ONNX_DIR=$(ls -d onnxruntime-linux-x64-*/ 2>/dev/null | head -n1) && \
    if [ -z "${ONNX_DIR}" ]; then \
        echo "Error: Failed to find extracted ONNX Runtime directory" && \
        ls -la /tmp/ && \
        exit 1; \
    fi && \
    echo "Found ONNX Runtime directory: ${ONNX_DIR}" && \
    mkdir -p /usr/local/include/onnxruntime && \
    if [ ! -d "${ONNX_DIR}include" ]; then \
        echo "Error: ${ONNX_DIR}include directory not found" && \
        ls -la "${ONNX_DIR}" && \
        exit 1; \
    fi && \
    cp -r ${ONNX_DIR}include/* /usr/local/include/onnxruntime/ && \
    if [ ! -d "${ONNX_DIR}lib" ]; then \
        echo "Error: ${ONNX_DIR}lib directory not found" && \
        ls -la "${ONNX_DIR}" && \
        exit 1; \
    fi && \
    cp -r ${ONNX_DIR}lib/* /usr/local/lib/ && \
    rm -rf /tmp/onnxruntime* && \
    ldconfig

# 设置 Go 环境
ENV GOPROXY=https://goproxy.cn,direct
ENV GOSUMDB=sum.golang.google.cn
ENV TZ=Asia/Shanghai

# 在 workspace 根目录工作
WORKDIR /build

# 复制整个项目（构建上下文是 xiaozhi-esp32-server-golang 目录）
COPY . ./xiaozhi-esp32-server-golang/

# 校验 asr_server 子模块内容已带入构建上下文
RUN test -f xiaozhi-esp32-server-golang/asr_server/server/setup.go || \
    (echo "ERROR: asr_server 子模块内容缺失" && exit 1)

# 设置 CGO 链接库路径（用于 onnxruntime 和 ten-vad）
ENV ONNXRUNTIME_DIR=/usr/local
ENV CGO_ENABLED=1
ENV CGO_CFLAGS="-I${ONNXRUNTIME_DIR}/include/onnxruntime -I/build/xiaozhi-esp32-server-golang/lib/ten-vad/include"
ENV CGO_LDFLAGS="-L${ONNXRUNTIME_DIR}/lib -lonnxruntime -L/build/xiaozhi-esp32-server-golang/lib/ten-vad/lib/Linux/x64"

# 在 xiaozhi-esp32-server-golang 目录下构建
RUN cd xiaozhi-esp32-server-golang && \
    go build -o /build/xiaozhi_server ./cmd/server/

# 运行阶段（使用 Ubuntu 基础镜像以支持 libc++/libc++abi）
FROM --platform=linux/amd64 ubuntu:22.04

# 安装运行时依赖
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    libopus0 \
    libopusfile0 \
    libc++1 \
    libc++abi1 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone

# 复制 onnxruntime 库文件（仅 x64）
COPY docker/lib/onnxruntime-linux-x64-1.21.0.tgz /tmp/

# 安装ONNX Runtime运行时（x64架构）
RUN echo "Installing ONNX Runtime for x64 architecture" && \
    cd /tmp && \
    if [ ! -f "onnxruntime-linux-x64-1.21.0.tgz" ]; then \
        echo "Error: ONNX Runtime file not found!" && \
        ls -la /tmp/*.tgz 2>/dev/null || echo "No .tgz files found" && \
        exit 1; \
    fi && \
    tar -xzf onnxruntime-linux-x64-1.21.0.tgz || (echo "Failed to extract ONNX Runtime" && exit 1) && \
    ONNX_DIR=$(ls -d onnxruntime-linux-x64-*/ 2>/dev/null | head -n1) && \
    if [ -z "${ONNX_DIR}" ]; then \
        echo "Error: Failed to find extracted ONNX Runtime directory" && \
        ls -la /tmp/ && \
        exit 1; \
    fi && \
    echo "Found ONNX Runtime directory: ${ONNX_DIR}" && \
    mkdir -p /usr/local/lib && \
    if [ ! -d "${ONNX_DIR}lib" ]; then \
        echo "Error: ${ONNX_DIR}lib directory not found" && \
        ls -la "${ONNX_DIR}" && \
        exit 1; \
    fi && \
    cp -r ${ONNX_DIR}lib/* /usr/local/lib/ && \
    rm -rf /tmp/onnxruntime* && \
    ldconfig

# 设置ONNX Runtime环境变量
ENV TZ=Asia/Shanghai
ENV ONNXRUNTIME_DIR=/usr/local
ENV CGO_CFLAGS="-I${ONNXRUNTIME_DIR}/include/onnxruntime"
ENV CGO_LDFLAGS="-L${ONNXRUNTIME_DIR}/lib -lonnxruntime"

# 设置工作目录
WORKDIR /workspace

# 从构建阶段复制编译后的二进制文件
COPY --from=builder /build/xiaozhi_server /workspace/bin/xiaozhi_server
# 复制 lib 目录（包含 ten-vad 运行时库）
COPY --from=builder /build/xiaozhi-esp32-server-golang/lib /workspace/lib

# 创建必要的目录
RUN mkdir -p /workspace/logs /workspace/config

# 设置运行时库路径（用于 ten-vad）
ENV LD_LIBRARY_PATH=/workspace/lib:/workspace/lib/ten-vad/lib/Linux/x64:/usr/local/lib

# 暴露端口: http/websocket:8989, udp:8990, mqtt: 1883,2883,8883
EXPOSE 8989 8990 1883 2883 8883

# 启动命令
CMD ["bin/xiaozhi_server", "-c", "config/config.yaml"]
